# Required
OPENAI_API_KEY=replace-with-your-openai-api-key

# Local development database connection.
# Docker Compose overrides this value inside the app container.
DATABASE_URL=postgresql://coreassist:coreassist@localhost:5432/coreassist

# Models
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
RETRIEVAL_LIMIT=5

# Optional: improves Hugging Face download rate limits.
HF_TOKEN=
